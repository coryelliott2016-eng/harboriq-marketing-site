    year: int | None = None
    engine_make: str | None = None
    engine_model: str | None = None
    engine_hours: int | None = None
    fuel_type: str | None = None


class JobCreate(BaseModel):
    customer_id: str | None = None
    vessel_id: str | None = None
    technician_id: str | None = None
    status: str = "NEW"
    service_type: str = "DIAGNOSTIC"
    symptom: str | None = None
    probable_fault: str | None = None
    priority: int = 0
    location: str | None = None
    scheduled_window: str | None = None


class TechnicianCreate(BaseModel):
    name: str
    email: str | None = None
    phone: str | None = None
    status: str = "AVAILABLE"
    location: str | None = None
    skills: list[str] = []


class WorkflowCreate(BaseModel):
    workflow_type: str = "MARINE_SERVICE"
    state_payload: dict[str, Any] = {}


class ReportCreate(BaseModel):
    job_id: str | None = None
    summary: str = "Service report generated."
    technician_notes: str | None = None
    status: str = "COMPLETE"


class LoginRequest(BaseModel):
    email: str | None = None
    password: str | None = None


class AIRequest(BaseModel):
