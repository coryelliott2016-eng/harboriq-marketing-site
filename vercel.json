FILES["frontend/src/main.jsx"] = """import React, { useEffect, useState } from "react";
import ReactDOM from "react-dom/client";
import "./style.css";

const API = "/api";

function App() {
  const [view, setView] = useState("dashboard");

  return (
    <main>
      <nav className="nav">
        <div>
          <p className="eyebrow">Off the Hook Marine Specialist</p>
          <h2>Marine Operations Platform</h2>
        </div>
        <div className="nav-actions">
          <button onClick={() => setView("dashboard")}>Dashboard</button>
          <button onClick={() => setView("customers")}>Customers</button>
          <button onClick={() => setView("jobs")}>Jobs</button>
          <button onClick={() => setView("dispatch")}>Dispatch</button>
          <button onClick={() => setView("workflow")}>Workflow</button>
          <button onClick={() => setView("ai")}>AI</button>
        </div>
      </nav>

      <header className="hero">
        <span className="badge">Premium Dockside Marine Intelligence</span>
        <h1>Luxury Marine Operations, Powered by Better Workflow.</h1>
        <p>
          Diagnostics, dispatch, reports, customer records, vessel tracking, technician workflows,
          and service intelligence in one command center.
        </p>
      </header>

      {view === "dashboard" && <Dashboard />}
      {view === "customers" && <Customers />}
      {view === "jobs" && <Jobs />}
      {view === "dispatch" && <Dispatch />}
      {view === "workflow" && <Workflow />}
      {view === "ai" && <AI />}
    </main>
  );
}

function Dashboard() {
  const [data, setData] = useState(null);

  async function load() {
    const res = await fetch(`${API}/operations/dashboard`);
    setData(await res.json());
  }

  useEffect(() => {
    load();
  }, []);

  return (
    <section className="panel">
      <div className="section-head">
        <h2>Operations Dashboard</h2>
        <button onClick={load}>Refresh</button>
      </div>
      <div className="cards">
        {data &&
          Object.entries(data).map(([key, value]) => (
            <div className="card" key={key}>
              <span>{key.replaceAll("_", " ")}</span>
              <strong>{String(value)}</strong>
            </div>
          ))}
      </div>
    </section>
  );
}

function Customers() {
  const [form, setForm] = useState({ full_name: "", phone: "", email: "", marina: "" });
  const [items, setItems] = useState([]);

  async function load() {
    const res = await fetch(`${API}/customers/`);
    setItems(await res.json());
  }

  async function create() {
    const res = await fetch(`${API}/customers/`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(form)
    });
    await res.json();
    setForm({ full_name: "", phone: "", email: "", marina: "" });
    load();
  }

  useEffect(() => {
    load();
  }, []);

  return (
    <section className="panel">
      <h2>Customer CRM</h2>
      <div className="grid">
        <input placeholder="Full name" value={form.full_name} onChange={e => setForm({ ...form, full_name: e.target.value })} />
        <input placeholder="Phone" value={form.phone} onChange={e => setForm({ ...form, phone: e.target.value })} />
        <input placeholder="Email" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} />
        <input placeholder="Marina" value={form.marina} onChange={e => setForm({ ...form, marina: e.target.value })} />
      </div>
      <button onClick={create}>Create Customer</button>
      <DataList items={items} />
    </section>
  );
}

function Jobs() {
  const [form, setForm] = useState({
    customer_id: "",
    symptom: "",
    service_type: "DIAGNOSTIC",
    location: "",
    priority: 1
  });
  const [items, setItems] = useState([]);

  async function load() {
    const res = await fetch(`${API}/jobs/`);
    setItems(await res.json());
  }

  async function create() {
    const payload = {
      ...form,
      customer_id: form.customer_id || null,
      priority: Number(form.priority || 0)
    };
    const res = await fetch(`${API}/jobs/`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    await res.json();
    setForm({ customer_id: "", symptom: "", service_type: "DIAGNOSTIC", location: "", priority: 1 });
    load();
  }

  useEffect(() => {
    load();
  }, []);

  return (
    <section className="panel">
      <h2>Job Intake</h2>
      <div className="grid">
        <input placeholder="Customer ID optional" value={form.customer_id} onChange={e => setForm({ ...form, customer_id: e.target.value })} />
        <input placeholder="Service type" value={form.service_type} onChange={e => setForm({ ...form, service_type: e.target.value })} />
        <input placeholder="Location / marina" value={form.location} onChange={e => setForm({ ...form, location: e.target.value })} />
        <input placeholder="Priority" type="number" value={form.priority} onChange={e => setForm({ ...form, priority: e.target.value })} />
      </div>
      <textarea placeholder="Describe the issue..." value={form.symptom} onChange={e => setForm({ ...form, symptom: e.target.value })} />
      <button onClick={create}>Create Job</button>
      <DataList items={items} />
    </section>
  );
}

function Dispatch() {
  const [data, setData] = useState(null);

  async function load() {
    const res = await fetch(`${API}/dispatch/board`);
    setData(await res.json());
  }

  return (
    <section className="panel">
      <h2>Dispatch Board</h2>
      <button onClick={load}>Load Dispatch</button>
      <pre>{data && JSON.stringify(data, null, 2)}</pre>
    </section>
  );
}

function Workflow() {
  const [data, setData] = useState(null);

  async function create() {
    const res = await fetch(`${API}/workflows/`, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ workflow_type: "MARINE_SERVICE", state_payload: { source: "frontend" } })
    });
    setData(await res.json());
  }

  async function advance() {
    if (!data?.workflow_id) return;
    const res = await fetch(`${API}/workflows/${data.workflow_id}/advance`, { method: "POST" });
    setData(await res.json());
  }

  return (
    <section className="panel">
      <h2>Workflow Engine</h2>
      <button onClick={create}>Create Workflow</button>
      <button onClick={advance}>Advance Step</button>
      <pre>{data && JSON.stringify(data, null, 2)}</pre>
    </section>
  );
}

function AI() {
  const [message, setMessage] = useState("");
  const [data, setData] = useState(null);

  async function ask() {
    const res = await fetch(`${API}/ai/chat`, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ message })
    });
    setData(await res.json());
  }

  return (
    <section className="panel">
      <h2>Marine AI Assistant</h2>
      <textarea value={message} onChange={e => setMessage(e.target.value)} placeholder="Describe a marine issue..." />
      <button onClick={ask}>Ask AI</button>
      <pre>{data && JSON.stringify(data, null, 2)}</pre>
    </section>
  );
}

function DataList({ items }) {
  return (
    <div className="list">
      {items.map((item, index) => (
        <pre key={index}>{JSON.stringify(item, null, 2)}</pre>
      ))}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
"""

FILES["frontend/src/style.css"] = """:root {
  --navy: #04111f;
  --gold: #d6b35a;
  --gold2: #f4d77a;
  --glass: rgba(255,255,255,.08);
  --border: rgba(214,179,90,.28);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, Arial, sans-serif;
  background:
    radial-gradient(circle at top right, rgba(214,179,90,.16), transparent 35%),
    linear-gradient(135deg,#020914,#071b2f 55%,#020914);
  color: white;
}

.nav {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  padding: 22px 8%;
  background: rgba(4,17,31,.9);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav h2 {
  color: var(--gold2);
  margin: 0;
}

.eyebrow {
  margin: 0 0 4px;
  color: #d8e4ec;
  font-size: 13px;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.nav-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

button {
  margin: 6px;
  padding: 12px 16px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg,var(--gold),var(--gold2));
  color: #04111f;
  font-weight: 800;
  cursor: pointer;
}

button:hover {
  filter: brightness(1.08);
}

.hero {
  padding: 100px 8%;
  background:
    linear-gradient(rgba(4,17,31,.55),rgba(4,17,31,.82)),
    url("https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1800&q=80");
  background-size: cover;
  background-position: center;
}

.hero h1 {
  font-size: clamp(42px, 6vw, 78px);
  max-width: 980px;
  margin: 18px 0;
  line-height: .98;
}

.hero p {
  font-size: 22px;
  max-width: 820px;
  color: #d8e4ec;
}

.badge {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 999px;
  color: var(--gold2);
  background: rgba(214,179,90,.12);
  border: 1px solid var(--border);
}

.panel {
  margin: 40px 8%;
  padding: 32px;
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 26px;
  box-shadow: 0 24px 80px rgba(0,0,0,.22);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(160px, 1fr));
  gap: 12px;
  margin-bottom: 14px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 16px;
}

.card {
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(2,9,20,.6);
}

.card span {
  display: block;
  color: #d8e4ec;
  text-transform: capitalize;
  margin-bottom: 10px;
}

.card strong {
  font-size: 34px;
  color: var(--gold2);
}

textarea,
input {
  width: 100%;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(2,9,20,.75);
  color: white;
}

textarea {
  min-height: 140px;
}

pre {
  background: rgba(2,9,20,.82);
  padding: 18px;
  border-radius: 16px;
  overflow: auto;
  border: 1px solid rgba(255,255,255,.08);
}

.list {
  margin-top: 22px;
}

@media (max-width: 850px) {
  .nav {
    align-items: flex-start;
    flex-direction: column;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding: 70px 6%;
  }

  .panel {
    margin: 28px 6%;
    padding: 22px;
  }
}
"""

FILES["nginx/nginx.conf"] = """worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    sendfile on;
    gzip on;

    include /etc/nginx/conf.d/*.conf;
}
"""

FILES["nginx/conf.d/app.conf"] = """server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://backend:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass http://backend:8000/docs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://backend:8000/openapi.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
}
"""


def write_files():
    for path, content in FILES.items():
        file_path = Path(path)
        file_path.parent.mkdir(parents=True, exist_ok=True)
        if content:
            file_path.write_text(content.strip() + "\n", encoding="utf-8")
        else:
            file_path.write_text("", encoding="utf-8")


if __name__ == "__main__":
    write_files()
    print("Finished generating Off the Hook Marine site.")
    print("Next command: docker compose up --build")
