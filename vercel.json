FILES["backend/app/api/routes/workflows.py"] = """from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from app.db.dependencies import get_db
from app.models.workflow import Workflow
from app.schemas import WorkflowCreate

router = APIRouter(prefix="/workflows", tags=["Workflows"])

STEPS = ["DIAGNOSTICS", "PREP", "QUOTE", "DISPATCH", "COMPLETE"]


@router.post("/")
def create_workflow(payload: WorkflowCreate, db: Session = Depends(get_db)):
    workflow = Workflow(
        workflow_type=payload.workflow_type,
        status="IN_PROGRESS",
        current_step="DIAGNOSTICS",
        state_payload=payload.state_payload,
    )
    db.add(workflow)
    db.commit()
    db.refresh(workflow)
    return workflow


@router.get("/")
def list_workflows(db: Session = Depends(get_db)):
    return db.query(Workflow).all()


@router.post("/{workflow_id}/advance")
def advance(workflow_id: str, db: Session = Depends(get_db)):
    workflow = db.query(Workflow).filter(Workflow.workflow_id == workflow_id).first()
    if not workflow:
        raise HTTPException(status_code=404, detail="Workflow not found")

    idx = STEPS.index(workflow.current_step)
    workflow.current_step = STEPS[min(idx + 1, len(STEPS) - 1)]
    workflow.status = "COMPLETE" if workflow.current_step == "COMPLETE" else "IN_PROGRESS"

    db.commit()
    db.refresh(workflow)
    return workflow
"""

FILES["backend/app/api/routes/ai.py"] = """from fastapi import APIRouter

from app.schemas import AIRequest

router = APIRouter(prefix="/ai", tags=["Marine AI"])


@router.post("/chat")
def chat(payload: AIRequest):
    message = payload.message.lower()

    if "battery" in message:
        response = "Battery issues often involve voltage drop, corrosion, cable resistance, weak cells, bad grounds, or charging-system failure."
        checks = ["Load-test batteries", "Inspect terminals", "Measure voltage drop", "Verify charger/alternator output"]
    elif "overheat" in message or "overheating" in message:
        response = "Overheating often points to impeller wear, restricted raw-water flow, thermostat failure, low coolant, belt issues, or heat-exchanger blockage."
        checks = ["Inspect impeller", "Check sea strainer", "Verify water flow", "Inspect thermostat", "Check heat exchanger"]
    elif "fuel" in message or "stall" in message:
        response = "Fuel-related complaints may involve clogged filters, water contamination, vent restriction, failing pump, injector issues, or tank pickup obstruction."
        checks = ["Check fuel filters", "Inspect fuel sample", "Verify tank vent", "Test fuel pressure"]
    else:
        response = "A qualified technician should inspect the vessel and verify system conditions before repair decisions are made."
        checks = ["Collect symptoms", "Verify operating conditions", "Document readings", "Escalate to technician review"]

    return {
        "response": response,
        "recommended_checks": checks,
        "disclaimer": "AI guidance supports operations only. Final diagnosis requires qualified technician review.",
    }
"""

